POSTGRES_DB=zbot
POSTGRES_USER=zbot
POSTGRES_PASSWORD=change-this-before-cloud-deployment
POSTGRES_PORT=5432
API_PORT=8000
# Control key: leave empty on your own computer (no lock, controls open).
# On a server, set a long random value (for example: openssl rand -hex 16). The dashboard then shows a lock and asks
# for this key once per device before any button that trades or changes money works. The server setup script fills
# this in for you. To change it, edit this line and run `docker compose up -d`: every device is locked again.
# See docs/guide/USER-GUIDE.md, "The control key".
STRATEGY_EDIT_TOKEN=
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=3000
LOG_LEVEL=INFO
BINANCE_REST_URL=https://data-api.binance.vision
BINANCE_WEBSOCKET_URL=wss://data-stream.binance.vision:443/ws
MARKET_DATA_BACKFILL_DAYS=32
MARKET_DATA_RECONNECT_SECONDS=5
MARKET_DATA_STALE_AFTER_SECONDS=180
